                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"Living Room Temperature\",\n    \"type\": \"temperature\",\n    \"location\": \"Living Room\",\n    \"unit\": \"°C\"\n}"
                        },
                        "url": {
                            "raw": "http://localhost:8080/api/v1/sensors",
                            "protocol": "http",
                            "host": ["localhost"],
                            "port": "8080",
                            "path": ["api", "v1", "sensors"]
