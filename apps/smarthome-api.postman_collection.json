                        "description": "Update a sensor's value and status"
                    },
                    "response": []
                },
                {
                    "name": "Send Command (via Monolith)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"type\": \"SET_TEMPERATURE\",\n    \"parameters\": {\n        \"target_temperature\": 22.5\n    }\n}"
                        },
                        "url": {
                            "raw": "http://localhost:8080/api/v1/sensors/1/command",
                            "protocol": "http",
                            "host": ["localhost"],
                            "port": "8080",
                            "path": ["api", "v1", "sensors", "1", "command"]
                        },
                        "description": "Send a command to a device via the monolith (proxied to Device Control Service)"
                    },
                    "response": []
                },
                {
                    "name": "Get Command Status (via Monolith)",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "http://localhost:8080/api/v1/commands/{{commandId}}",
                            "protocol": "http",
                            "host": ["localhost"],
                            "port": "8080",
                            "path": ["api", "v1", "commands", "{{commandId}}"]
                        },
                        "description": "Get command details via the monolith (proxied to Device Control Service)"
                    },
                    "response": []
                }
            ]
