                {
                    "name": "Update Sensor Value",
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"value\": 22.5,\n    \"status\": \"active\"\n}"
                        },
                        "url": {
                            "raw": "http://localhost:8080/api/v1/sensors/1/value",
                            "protocol": "http",
                            "host": ["localhost"],
                            "port": "8080",
                            "path": ["api", "v1", "sensors", "1", "value"]
